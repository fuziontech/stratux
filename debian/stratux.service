[Unit]
Description=Stratux
After=network.target bluetooth.target stratux-update.service

[Service]
ExecStart=/opt/stratux/bin/stratuxrun
KillMode=control-group
Restart=always
RestartSec=5
LimitCORE=0
StandardOutput=null

# Baseline hardening compatible with Stratux network/hardware/overlay management
ProtectHome=read-only
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
