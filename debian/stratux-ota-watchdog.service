[Unit]
Description=Stratux OTA Health-Check Watchdog and Auto-Rollback
After=stratux-update.service stratux.service
Wants=stratux.service
ConditionPathExists=!/run/stratux-ota-install.lock

[Service]
Type=oneshot
ExecStart=/opt/stratux/bin/stratux-ota-watchdog.sh

[Install]
WantedBy=multi-user.target
