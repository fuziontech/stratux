#!/bin/bash
set -e

case "${1:-}" in
	install|upgrade)
		echo "Running pre-installation script and stopping the stratux service"
		if [ -d /run/systemd/system ]; then
			# Raspberry Pi's have config.txt so this is one way to determine if it is a Raspberry Pi
			arch="$(uname -m)"
			if [ "${arch}" = "aarch64" ] && [ -f "/boot/firmware/config.txt" ]; then
				# check to see if we are running the 'new' fancontrol
				if [ -f "/lib/systemd/system/stratux_fancontrol.service" ]; then
					systemctl stop stratux_fancontrol.service 2>/dev/null || true
				elif [ -x "/opt/stratux/bin/fancontrol" ]; then
					/opt/stratux/bin/fancontrol stop 2>/dev/null || true
					/opt/stratux/bin/fancontrol remove 2>/dev/null || true
				fi
			fi

			echo "Stopping stratux before installing the new version"
			systemctl stop stratux.service 2>/dev/null || true
		fi
		;;
	abort-upgrade)
		;;
esac

exit 0
