#!/bin/bash
set -e

case "${1:-}" in
	remove|upgrade|deconfigure)
		echo "Running pre-removal script for the stratux service"
		if [ "${STRATUX_OTA_INSTALL:-0}" = "1" ]; then
			echo "Boot-time OTA install in progress; skipping service stop"
		elif [ -d /run/systemd/system ]; then
			arch="$(uname -m)"
			if [ "${arch}" = "aarch64" ] && [ -f "/boot/firmware/config.txt" ]; then
				systemctl stop stratux_fancontrol.service 2>/dev/null || true
			fi
			systemctl stop stratux.service 2>/dev/null || true
			systemctl stop stratux-usb-gadget.service 2>/dev/null || true
		fi

		if [ "${1:-}" = "remove" ]; then
			systemctl disable stratux.service 2>/dev/null || true
			systemctl disable stratux-update.service 2>/dev/null || true
			systemctl disable stratux-ota-watchdog.service 2>/dev/null || true
			systemctl disable stratux-usb-gadget.service 2>/dev/null || true
			systemctl disable stratux_fancontrol.service 2>/dev/null || true
		fi
		;;
	failed-upgrade)
		;;
esac

exit 0
