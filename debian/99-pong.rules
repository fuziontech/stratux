# pongradio.com Pong dual ADS-B receiver udev rule
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idProduct}=="6998", ATTRS{idVendor}=="0403", RUN+="/sbin/modprobe -q ftdi_sio", RUN+="/bin/sh -c 'echo 0403 6998 > /sys/bus/usb-serial/drivers/ftdi_sio/new_id'"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idProduct}=="6998", ATTRS{idVendor}=="0403", OWNER="root", GROUP="dialout", MODE="0660", SYMLINK+="pong"
