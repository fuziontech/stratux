{
    "go.useLanguageServer": true,
    "go.toolsEnvVars": {
        "CGO_CFLAGS_ALLOW": "-L${workspaceFolder}",
        "LIBRARY_PATH": "${workspaceFolder}",
        "LD_LIBRARY_PATH": "${workspaceFolder}"
    },
    "go.buildOnSave": "off",

    "terminal.integrated.env.linux": {
        "CGO_CFLAGS_ALLOW": "-L${workspaceFolder}",
        "LIBRARY_PATH": "${workspaceFolder}",
        "LD_LIBRARY_PATH": "${workspaceFolder}"
    },

    "[go]": {
        "editor.formatOnSave": false
    },

    // Use this to make it possible to hide the stratuxrun vs fancontrol redeclaration errors..
    "files.exclude": {
        "**/.git": true,
        "ogn/esp-idf/**": true,
        "test/**": true
    }
}
